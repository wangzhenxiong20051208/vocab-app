/* pages/speak/speak.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
}

/* 词本选择 */
.book-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  margin: 20rpx 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.selector-label { font-size: 28rpx; font-weight: 500; color: #333; }
.selector-arrow { font-size: 20rpx; color: #999; }

/* 播放区域 */
.player-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 40rpx 20rpx;
}

/* 进度 */
.progress-container {
  width: 100%;
  margin-bottom: 20rpx;
}

.progress-track slider {
  width: 100%;
}

.progress-count {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* 单词卡片 */
.word-display {
  background: white;
  width: 100%;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  text-align: center;
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.word-big {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.meaning-area {
  margin-top: 10rpx;
}

.meaning-text {
  font-size: 38rpx;
  color: #4a90d9;
  font-weight: 500;
  display: block;
  line-height: 1.5;
}

.example-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-top: 16rpx;
  font-style: italic;
  line-height: 1.4;
}

.waiting-area {
  margin-top: 10rpx;
}

.waiting-dots {
  font-size: 60rpx;
  color: #ccc;
  letter-spacing: 10rpx;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* 空状态 */
.empty-hint {
  text-align: center;
  padding: 80rpx 0;
}

.empty-hint text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.empty-icon { font-size: 64rpx; }

/* 控制区域 */
.controls-area {
  padding: 0 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 16rpx;
}

.ctrl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s;
}

.ctrl-btn:active { transform: scale(0.9); }

.ctrl-btn text { font-size: 48rpx; }

.play-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #4a90d9, #357abd);
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
}

.play-btn text { font-size: 52rpx; }

.prev-btn text, .next-btn text { font-size: 44rpx; opacity: 0.6; }

.state-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.timer-text {
  font-size: 22rpx;
  color: #e74c3c;
  margin-bottom: 20rpx;
}

/* 快捷设置 */
.quick-settings {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-top: 10rpx;
}

.qs-item {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.qs-item:active { background: #f0f0f0; }

.qs-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.qs-value {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

/* 词本选择弹窗 */
.book-picker {
  padding-bottom: 20rpx;
}

.picker-list {
  max-height: 500rpx;
  margin-bottom: 24rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-item:active { background: #f5f7fa; }
.picker-item.active { background: #e8f0fe; }

.picker-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.picker-count {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.picker-check {
  color: #4a90d9;
  font-weight: 700;
}

.picker-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
