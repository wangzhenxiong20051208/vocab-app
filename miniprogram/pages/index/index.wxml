<!-- pages/index/index.wxml -->
<view class="page-container">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <icon type="search" size="16" color="#999"></icon>
    <input class="search-input" placeholder="搜索词本..."
           value="{{searchKeyword}}" bindinput="onSearchInput" />
  </view>

  <!-- 词本列表 -->
  <scroll-view class="book-list" scroll-y>
    <view wx:for="{{books}}" wx:key="id" class="book-card"
          bindtap="openBook" data-id="{{item.id}}">
      <view class="book-icon">
        <text class="book-icon-text">📖</text>
      </view>
      <view class="book-info">
        <text class="book-name">{{item.name}}</text>
        <text class="book-meta">{{item.wordCount}} 个单词 · {{formatTime(item.createdAt)}}</text>
      </view>
      <view class="book-actions">
        <view class="action-btn" bindtap="confirmDelete" data-id="{{item.id}}" catchtap>
          <text class="action-text">删除</text>
        </view>
        <view class="action-btn" bindtap="onRename" data-id="{{item.id}}" catchtap>
          <text class="action-text">重命名</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{books.length == 0}}" class="empty-state">
      <text class="empty-icon">📝</text>
      <text class="empty-text">还没有词本，点击下方按钮创建</text>
    </view>
  </scroll-view>

  <!-- 创建按钮 -->
  <view class="fab" bindtap="showCreate">
    <text class="fab-icon">+</text>
    <text class="fab-text">新建词本</text>
  </view>

  <!-- 创建词本弹窗 -->
  <view wx:if="{{showCreateDialog}}" class="modal-overlay" bindtap="hideCreate">
    <view class="modal-content" catchtap>
      <text class="modal-title">新建词本</text>
      <input class="modal-input" placeholder="输入词本名称"
             value="{{newBookName}}" bindinput="onBookNameInput"
             focus="{{showCreateDialog}}" />
      <view class="modal-buttons">
        <button class="btn-cancel" bindtap="hideCreate">取消</button>
        <button class="btn-confirm" bindtap="createBook">创建</button>
      </view>
    </view>
  </view>

  <!-- 删除确认弹窗 -->
  <view wx:if="{{showDeleteConfirm}}" class="modal-overlay" bindtap="cancelDelete">
    <view class="modal-content" catchtap>
      <text class="modal-title">确认删除</text>
      <text class="modal-desc">删除后词本内所有单词将丢失，确定要删除吗？</text>
      <view class="modal-buttons">
        <button class="btn-cancel" bindtap="cancelDelete">取消</button>
        <button class="btn-danger" bindtap="doDelete">删除</button>
      </view>
    </view>
  </view>
</view>
