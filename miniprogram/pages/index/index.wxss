/* pages/index/index.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 140rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: white;
  margin: 20rpx 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #333;
}

/* 词本卡片 */
.book-list {
  padding: 0 24rpx;
}

.book-card {
  display: flex;
  align-items: center;
  background: white;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: transform 0.2s;
}

.book-card:active {
  transform: scale(0.98);
}

.book-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #e8f0fe;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.book-icon-text {
  font-size: 36rpx;
}

.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.book-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.book-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.book-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 8rpx;
}

/* 空状态 */
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* FAB 按钮 */
.fab {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #4a90d9, #357abd);
  color: white;
  padding: 24rpx 56rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  z-index: 100;
}

.fab:active {
  transform: translateX(-50%) scale(0.96);
}

.fab-icon {
  font-size: 36rpx;
  font-weight: 300;
  margin-right: 12rpx;
}

.fab-text {
  font-size: 30rpx;
  font-weight: 500;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 28rpx;
  padding: 40rpx 48rpx;
  width: 600rpx;
  max-width: 85%;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
}

.modal-input {
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.modal-buttons {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  background: #f0f0f0;
  color: #666;
  border: none;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-confirm {
  flex: 1;
  background: linear-gradient(135deg, #4a90d9, #357abd);
  color: white;
  border: none;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-danger {
  flex: 1;
  background: #e74c3c;
  color: white;
  border: none;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  text-align: center;
}
